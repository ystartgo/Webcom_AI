# Auto detect text files and perform LF normalization
* text=auto

# Windows batch, shell and script files MUST preserve CRLF (never convert to LF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf

# Binary files
*.wasm binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
*.png binary
*.jpg binary
*.ico binary
